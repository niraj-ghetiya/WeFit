<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.WeFit" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/wefit_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <style name="Theme.WeFit.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/wefit_splash</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.WeFit</item>
    </style>
</resources>
